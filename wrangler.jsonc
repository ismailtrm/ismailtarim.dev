{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ismailtarim-dev",
  "main": "src/index.tsx",
  "compatibility_date": "2026-10-26",
  "upload_source_maps": true,
  // zod 4 is large unminified; minifying keeps the Worker small and its startup fast.
  "minify": true,
  // Builds the /admin panel into public/admin before every deploy and dev session.
  "build": { "command": "bun run build:admin" },
  "observability": { "enabled": true },

  // The site is served only on its own domain. No workers.dev or preview hostnames,
  // so /admin cannot be reached around Cloudflare Access.
  "routes": [{ "pattern": "ismailtarim.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,

  // Static files (CSS, fonts, favicon, later the /admin bundle) are served before the Worker runs.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ismailtarim-db",
      "database_id": "e685a90b-d563-4d67-ad5e-be6d7c27d32d",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "ismailtarim-media" }
  ],

  // Non-secret settings. Secrets (D1 export token, Access audience) go through `wrangler secret put`.
  "vars": {
    "SITE_URL": "https://ismailtarim.dev",
    "SITE_NAME": "İsmail Tarım",
    "PAGE_CACHE_SECONDS": "60",
    "BACKUP_KEEP_DAILY": "30",
    "BACKUP_KEEP_MONTHLY": "12",
    // /admin is a Cloudflare Access app; the Worker re-checks its JWT against these.
    "ACCESS_TEAM_DOMAIN": "https://solitary-leaf-fa02.cloudflareaccess.com",
    "ACCESS_AUD": "13143e40f4537fb1d09362774c5b7a6532c51cc736b6de4ac4a1670f648f5453",
    "ADMIN_EMAIL": "ismailtarim7@gmail.com"
  }
}
