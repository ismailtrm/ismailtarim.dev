{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ismailtarim-dev",
  "main": "src/index.tsx",
  "compatibility_date": "2026-10-30",
  "upload_source_maps": true,
  "observability": { "enabled": true },

  // The site is served only on its own domain. No workers.dev or preview hostnames,
  // so /admin cannot be reached around Cloudflare Access.
  "routes": [{ "pattern": "ismailtarim.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,

  // Static files (CSS, fonts, favicon, later the /admin bundle) are served before the Worker runs.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ismailtarim-db",
      "database_id": "e685a90b-d563-4d67-ad5e-be6d7c27d32d",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "ismailtarim-media" }
  ],

  // Non-secret settings. Secrets (D1 export token, Access audience) go through `wrangler secret put`.
  "vars": {
    "SITE_URL": "https://ismailtarim.dev",
    "SITE_NAME": "İsmail Tarım",
    "PAGE_CACHE_SECONDS": "60",
    "BACKUP_KEEP_DAILY": "30",
    "BACKUP_KEEP_MONTHLY": "12"
  }
}
